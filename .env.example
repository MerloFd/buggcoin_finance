# Copie este arquivo para `.env.local` e preencha com os SEUS valores.
# `.env.local` está no .gitignore e nunca deve ser commitado.

# --- Pluggy (opcional) ---
# Só é necessário se você quiser conectar banco. O app funciona inteiro sem isso.
# Crie uma conta gratuita em https://meu.pluggy.ai para conectar as suas próprias
# contas (até 5). As credenciais ficam em https://dashboard.pluggy.ai
# (Settings > API Keys).
#
# NUNCA prefixe estas duas com NEXT_PUBLIC_ — isso as enviaria ao navegador.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- Supabase ---
# Crie um projeto em https://supabase.com/dashboard e rode `supabase/schema.sql`
# seguido de `supabase/migrations/001_debts_and_multibank.sql` no SQL Editor.
# Os valores abaixo ficam em Project Settings > API.
#
# A anon key é client-safe por design: quem protege os dados é a RLS definida no
# schema, não o sigilo desta chave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
